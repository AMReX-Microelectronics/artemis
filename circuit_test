#                                                                         - (z-floor(z/pitchz)*pitchz)**2/(2*radius**2)) + 8.8541878128e-12 "
macroscopic.epsilon_function(x,y,z) = "(EPR - 1) * 8.8541878128e-12 * (abs(x+length)/pitchx)
                                   + 8.8541878128e-12 " 
# sigma & epsilon. These two don't need to align
# 1. uniform thickness: step layer; sweep pitchx
# 2. uniform thickness: remove "floor" for continuous epsilon; sweep pitchx 
# 3. uniform thickness: shuffle layers
# 4. nonuniform layer thickness: random number generator
# 5. change x layer to z layer
# max EPR <= 100; min EPR = 1
warpx.E_excitation_on_grid_style = "parse_E_excitation_grid_function"
warpx.Ex_excitation_grid_function(x,y,z,t) = "1.25663706212e-06 * (exp(-(t-3*TP)**2/(2*TP**2))*cos(2*pi*c/wavelength*t)) * (x <= + rjx) * (x >= - rjx) * (z <= + rjz) * (z >= - rjz)"
