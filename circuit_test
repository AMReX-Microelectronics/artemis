warpx.Ey_excitation_flag_function(x,y,z) = "flag_none"
warpx.Ez_excitation_flag_function(x,y,z) = "flag_none"
# source sweep
# 1. change Ex to Ey (keep slice direction to be x)
# 2. sweep source location
# 3. sweep wavelength
warpx.B_excitation_on_grid_style = "parse_B_excitation_grid_function"
warpx.Bx_excitation_grid_function(x,y,z,t) = "0.0"
warpx.By_excitation_grid_function(x,y,z,t) = "(exp(-(t-3*TP)**2/(2*TP**2))*cos(2*pi*c/wavelength*t)) * (x <= + rjx) * (x >= - rjx) * (z <= + rjz) * (z >= - rjz)"
warpx.Bz_excitation_grid_function(x,y,z,t) = "0.0"
warpx.Bx_excitation_flag_function(x,y,z) = "flag_none"
warpx.By_excitation_flag_function(x,y,z) = "flag_ss * (x <= + rjx) * (x >= - rjx) * (z <= + rjz) * (z >= - rjz)"
warpx.Bz_excitation_flag_function(x,y,z) = "flag_none"
